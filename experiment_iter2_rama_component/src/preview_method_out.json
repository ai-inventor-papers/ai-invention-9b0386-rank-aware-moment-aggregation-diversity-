{
  "metadata": {
    "experiment": "RAMA Component Ablation on rel-f1/driver-position",
    "description": "Controlled ablation study isolating each RAMA component (variance injection, rank-based gating, LayerNorm confounding) on the rel-f1/driver-position regression task.",
    "methods": [
      "standard_mean",
      "mean_layernorm",
      "ungated_moment"
    ],
    "hyperparameters": {
      "channels": 128,
      "num_layers": 2,
      "lr": 0.005,
      "batch_size": 512,
      "epochs": 10,
      "num_neighbors": [
        128,
        128
      ],
      "seeds": [
        42,
        123,
        456
      ]
    },
    "dataset_info": {
      "dataset": "rel-f1",
      "task": "driver-position",
      "train_size": 7453,
      "val_size": 499,
      "test_size": 760,
      "num_tables": 9,
      "num_fk_edges": 13,
      "key_high_cardinality_edges": [
        "results.constructorId->constructors (mean=124, max=2371)",
        "results.driverId->drivers (mean=30, max=370)"
      ]
    },
    "statistical_analysis": {
      "hypothesis_tests": {
        "gating_necessity": {
          "comparison": "ungated_moment vs rama_full",
          "question": "Does gating add value beyond ungated variance injection?",
          "d": 5.2756,
          "se": 1.3385,
          "ci_lo": 2.6521,
          "ci_hi": 7.8991,
          "p_value": 8.1e-05,
          "conclusion": "rama_full significantly better (d=5.28)"
        },
        "rank_conditioning": {
          "comparison": "rama_no_rank vs rama_full",
          "question": "Does rank conditioning specifically help?",
          "d": -0.1349,
          "se": 0.6332,
          "ci_lo": -1.3759,
          "ci_hi": 1.1061,
          "p_value": 0.831271,
          "conclusion": "No significant difference (d=-0.13)"
        },
        "layernorm_confounder": {
          "comparison": "standard_mean vs mean_layernorm",
          "question": "Is LayerNorm a confounder?",
          "d": -2.1175,
          "se": 0.7901,
          "ci_lo": -3.666,
          "ci_hi": -0.569,
          "p_value": 0.007358,
          "conclusion": "standard_mean significantly better (d=-2.12)"
        },
        "rama_vs_pna": {
          "comparison": "pna_style vs rama_full",
          "question": "Does targeted gated variance beat multi-aggregator?",
          "d": 3.2546,
          "se": 0.9642,
          "ci_lo": 1.3648,
          "ci_hi": 5.1443,
          "p_value": 0.000737,
          "conclusion": "rama_full significantly better (d=3.25)"
        },
        "variance_value": {
          "comparison": "standard_mean vs ungated_moment",
          "question": "Does variance injection help at all?",
          "d": 1.7975,
          "se": 0.7494,
          "ci_lo": 0.3288,
          "ci_hi": 3.2663,
          "p_value": 0.016453,
          "conclusion": "ungated_moment significantly better (d=1.80)"
        },
        "rama_vs_baseline": {
          "comparison": "standard_mean vs rama_full",
          "question": "The headline comparison: RAMA vs standard mean",
          "d": 11.8219,
          "se": 2.7181,
          "ci_lo": 6.4945,
          "ci_hi": 17.1493,
          "p_value": 1.4e-05,
          "conclusion": "rama_full significantly better (d=11.82)"
        }
      },
