{
  "metadata": {
    "experiment": "RAMA Integration: RelGNN vs baseline on rel-f1 and rel-amazon",
    "method_name": "RAMA (Rank-Aware Moment Aggregation)",
    "architecture_used": "RelGNN",
    "description": "Tests RAMA against standard sum aggregation using RelGNN on rel-f1/driver-position and rel-amazon/item-ltv (regression/MAE). RAMA enriches mean pooling with gated per-dimension variance conditioned on spectral rank proxy and cardinality.",
    "tasks": [
      "rel-f1/driver-position",
      "rel-amazon/item-ltv"
    ],
    "hyperparameters": {
      "channels": 128,
      "lr": 0.005,
      "epochs": 10,
      "seeds": [
        42,
        123,
        456,
        789,
        1024
      ],
      "max_steps_per_epoch": 2000,
      "rama_gate_hidden": 16,
      "task_configs": {
        "rel-f1/driver-position": {
          "num_model_layers": 1,
          "channels": 128,
          "aggr": "sum",
          "num_heads": 4,
          "batch_size": 512,
          "num_neighbors": 128,
          "subgraph_type": "bidirectional"
        },
        "rel-amazon/item-ltv": {
          "num_model_layers": 2,
          "channels": 128,
          "aggr": "sum",
          "num_heads": 8,
          "batch_size": 2048,
          "num_neighbors": 128,
          "subgraph_type": "directional"
        }
      }
    },
    "num_seeds": 5,
    "total_runtime_seconds": 8444.902473449707,
    "comparison_with_heterosage": {
      "rel-f1/driver-position": {
